# ---------------------------------------------------------------------------
# Sentinel configuration. Copy to `.env` and fill in. Nothing here is required
# to run the demo in mock mode (the defaults below run end-to-end with zero
# credits and no external network access).
# ---------------------------------------------------------------------------

# "mock" runs the full pipeline with a simulated Devin + GitHub (great for the
# demo / Loom). "live" hits the real Devin API and GitHub.
SENTINEL_MODE=mock

# --- Devin API (only needed in live mode) ---------------------------------
# Get this from https://app.devin.ai/settings (token looks like apk_... or cog_...)
DEVIN_API_KEY=
DEVIN_BASE_URL=https://api.devin.ai/v1
# Cap spend per remediation session so an automated loop can't run away.
DEVIN_MAX_ACU_LIMIT=10
# ENTERPRISE / service-user (cog_) tokens are org-scoped and use the v3 API.
# Set your organization id (e.g. org-2eefdf...) to switch Sentinel to v3.
# Leave blank for a personal (apk_) key on the v1 API.
DEVIN_ORG_ID=

# --- GitHub (only needed in live mode) ------------------------------------
# A fine-grained PAT with issues:read/write on your Superset fork.
GITHUB_TOKEN=
# The fork you created in Part 1, e.g. "your-org/superset".
TARGET_REPO=your-org/superset
# Only issues carrying this label are remediated by Sentinel.
TRIGGER_LABEL=devin-fix
# Shared secret used to verify GitHub webhook signatures (optional in mock).
GITHUB_WEBHOOK_SECRET=

# --- Runtime --------------------------------------------------------------
SENTINEL_DB_PATH=data/sentinel.db
# How often the background tracker polls Devin for session status (seconds).
POLL_INTERVAL_SECONDS=10
# In mock mode, how many polls before a simulated session "finishes".
MOCK_POLLS_TO_FINISH=3
